#pragma code_page(65001)
#include <winver.h>

@KUJIRA_RC_ICON@
VS_VERSION_INFO VERSIONINFO
FILEVERSION @KUJIRA_VERSION_COMMA@,0
PRODUCTVERSION @KUJIRA_VERSION_COMMA@,0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "080404b0"
        BEGIN
            VALUE "FileDescription", "鲸鱼娘 Kujira"
            VALUE "FileVersion", "@PROJECT_VERSION@"
            VALUE "InternalName", "Kujira"
            VALUE "OriginalFilename", "Kujira.exe"
            VALUE "ProductName", "鲸鱼娘 Kujira"
            VALUE "ProductVersion", "@PROJECT_VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x804, 1200
    END
END
